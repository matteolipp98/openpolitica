{
  "type": "object",
  "properties": {
    "versione": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "frasiNumeri": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "se": {
            "type": "string"
          },
          "altrimenti": {
            "type": "boolean",
            "const": true
          },
          "testo": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "testo"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "letture": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metrica": {
            "type": "string",
            "enum": [
              "numeri_sbagliati",
              "non_controllabili",
              "voti_contrari",
              "promesse_non_mantenute"
            ]
          },
          "verso": {
            "type": "string",
            "enum": [
              "max",
              "min"
            ]
          },
          "aggregata": {
            "type": "boolean",
            "default": false
          },
          "testo": {
            "type": "string",
            "maxLength": 120
          },
          "testoPiu": {
            "type": "string",
            "maxLength": 120
          },
          "sotto": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "metrica",
          "testo",
          "sotto"
        ],
        "additionalProperties": false
      }
    },
    "andamento": {
      "type": "object",
      "properties": {
        "confronto": {
          "type": "object",
          "properties": {
            "piu": {
              "type": "string"
            },
            "meno": {
              "type": "string"
            },
            "uguale": {
              "type": "string"
            },
            "pochi": {
              "type": "string"
            }
          },
          "required": [
            "piu",
            "meno",
            "uguale",
            "pochi"
          ],
          "additionalProperties": false
        },
        "metriche": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "vota_con_governo",
                  "vota_compatto",
                  "numeri_sbagliati",
                  "promesse_precise",
                  "annunci_seguiti",
                  "frasi_contro"
                ]
              },
              "nome": {
                "type": "string",
                "maxLength": 40
              },
              "spiega": {
                "type": "string",
                "maxLength": 160
              },
              "frase": {
                "type": "string",
                "maxLength": 80
              },
              "notaGoverno": {
                "type": "string",
                "maxLength": 100
              },
              "notaOpposizione": {
                "type": "string",
                "maxLength": 100
              },
              "presto": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "id",
              "nome",
              "spiega",
              "frase"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "confronto",
        "metriche"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "versione",
    "frasiNumeri",
    "letture",
    "andamento"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
