{
  "type": "object",
  "properties": {
    "versione": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "aggiornato_il": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "elezioni": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "elenco": {
            "type": "string",
            "format": "uri"
          },
          "programmi": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "partiti": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "minItems": 1
                },
                "contrassegno": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "partiti",
                "contrassegno"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "data",
          "elenco",
          "programmi"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "versione",
    "aggiornato_il",
    "elezioni"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
